#!/bin/sh
set -eu

EXIT_UNAVAILABLE=3
EXIT_USAGE=64
BASE64_MARKER="base64:"
newline='
'
carriage_return=$(printf '\r')

fail() {
    code="$1"
    shift
    echo "keyguard provider 1password: $*" >&2
    exit "$code"
}

require_name() {
    case "$1" in
        '' | [!A-Za-z_]* | *[!A-Za-z0-9_]*) fail "$EXIT_USAGE" "not a variable name: $1" ;;
    esac
}

on_one_line() {
    case "$1" in
        "$BASE64_MARKER"* | *"$newline"* | *"$carriage_return"*)
            printf '%s%s' "$BASE64_MARKER" "$(printf '%s' "$1" | base64 | tr -d '\n')"
            ;;
        *) printf '%s' "$1" ;;
    esac
}

vault="${KEYGUARD_OP_VAULT:-}"
field="${KEYGUARD_OP_FIELD:-password}"

get_values() {
    [ "$#" -gt 0 ] || fail "$EXIT_USAGE" "usage: get NAME..."
    [ -n "$vault" ] || fail "$EXIT_UNAVAILABLE" "set KEYGUARD_OP_VAULT to the vault that holds the secrets"
    for name in "$@"; do
        require_name "$name"
    done
    lines=""
    for name in "$@"; do
        value=$(op read --no-newline "op://$vault/$name/$field") || fail "$EXIT_UNAVAILABLE" "1Password did not release $name"
        lines="$lines$name=$(on_one_line "$value")$newline"
    done
    printf '%s' "$lines"
}

verb="${1:-}"
if [ "$#" -gt 0 ]; then
    shift
fi
case "$verb" in
    get) get_values "$@" ;;
    *) fail "$EXIT_USAGE" "verb not supported: $verb" ;;
esac
